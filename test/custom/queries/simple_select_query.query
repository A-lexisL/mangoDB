LOAD db/select_inventory.tbl;
SELECT ( KEY price stock rating ) FROM Inventory;
SELECT ( KEY stock price ) FROM Inventory WHERE ( price >= 10 ) ( stock < 6 );
SELECT ( KEY ) FROM Inventory;
SELECT ( KEY rating ) FROM Inventory WHERE ( KEY = b );
SELECT ( KEY price ) FROM Inventory WHERE ( price > 10 ) ( stock <= 6 ) ( rating >= -9 );
SELECT ( KEY price ) FROM Inventory WHERE ( price > 100 );
SELECT ( KEY ) FROM Inventory WHERE ( KEY = a ) ( KEY = b ) ( rating > 0 );
SELECT ( KEY price ) FROM Inventory WHERE ( KEY = b );
SELECT ( KEY stock ) FROM Inventory WHERE ( price = 10 );
LOAD db/select_empty.tbl;
SELECT ( KEY price stock ) FROM Empty;
SELECT ( KEY stock price ) FROM Inventory WHERE ( KEY = a );
SELECT ( KEY price missing ) FROM Inventory;
SELECT ( KEY price ) FROM Missing;
SELECT ( KEY price ) FROM Inventory WHERE ( KEY > a );
SELECT ( KEY price ) FROM Inventory WHERE ( price != 10 );
SELECT ( KEY ) FROM Inventory WHERE ( KEY = a );
DUMP Inventory tmp/select_after.tbl;
INSERT ( z 7 9 -1 ) FROM Inventory;
UPDATE ( price -30 ) FROM Inventory WHERE ( KEY = a );
SELECT ( KEY price ) FROM Inventory WHERE ( price < 0 );
SELECT ( KEY price stock rating ) FROM Inventory WHERE ( KEY = z );
QUIT;
