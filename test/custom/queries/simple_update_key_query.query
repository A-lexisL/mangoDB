LOAD db/update_keys.tbl;
UPDATE ( KEY beta ) FROM UpdateKeys WHERE ( KEY = alpha );
SELECT ( KEY score ) FROM UpdateKeys WHERE ( KEY = alpha );
SELECT ( KEY score ) FROM UpdateKeys WHERE ( KEY = beta );
UPDATE ( KEY alpha ) FROM UpdateKeys WHERE ( KEY = alpha );
UPDATE ( KEY unused ) FROM UpdateKeys WHERE ( KEY = missing );
UPDATE ( KEY unused ) FROM UpdateKeys WHERE ( KEY = alpha ) ( score > 100 );
UPDATE ( KEY renamed ) FROM UpdateKeys WHERE ( KEY = zeta ) ( score = 90 );
SELECT ( KEY score ) FROM UpdateKeys WHERE ( KEY = zeta );
SELECT ( KEY score ) FROM UpdateKeys WHERE ( KEY = renamed );
UPDATE ( KEY winner ) FROM UpdateKeys WHERE ( score >= 90 );
UPDATE ( KEY nobody ) FROM UpdateKeys WHERE ( score > 200 );
UPDATE ( KEY fresh ) FROM UpdateKeys WHERE ( score >= 90 );
SELECT ( KEY score ) FROM UpdateKeys WHERE ( KEY = fresh );
SELECT ( KEY score ) FROM UpdateKeys WHERE ( KEY = alpha );
UPDATE ( KEY fresh ) FROM UpdateKeys WHERE ( score >= 90 );
UPDATE ( KEY ignored ) FROM UpdateKeys WHERE ( KEY = alpha ) ( KEY = beta );
DUPLICATE FROM UpdateKeys WHERE ( KEY = alpha ) ( score > 100 );
DUPLICATE FROM UpdateKeys WHERE ( KEY = alpha ) ( score = 95 );
DELETE FROM UpdateKeys WHERE ( KEY = alpha_copy ) ( score < 0 );
DELETE FROM UpdateKeys WHERE ( KEY = alpha_copy ) ( score = 95 );
DUPLICATE FROM UpdateKeys WHERE ( KEY = missing );
DELETE FROM UpdateKeys WHERE ( KEY = missing );
UPDATE ( score 0 ) FROM UpdateKeys WHERE ( KEY = alpha ) ( score > 100 );
SELECT ( KEY score other ) FROM UpdateKeys;
DUMP UpdateKeys tmp/update_key_after.tbl;
LOAD db/empty.tbl;
UPDATE ( KEY nobody ) FROM empty;
UPDATE ( KEY nobody ) FROM empty WHERE ( KEY = missing );
QUIT;
